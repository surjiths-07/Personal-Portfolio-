# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
# Option 1 (recommended for cloud MySQL like Railway/Aiven/TiDB):
# DATABASE_URL=mysql://username:password@host:3306/portfolio_db?ssl-mode=REQUIRED

# Option 2 (individual parameters):
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=portfolio_db
DB_SSL=false

# Frontend Origin for CORS (comma-separated; optional on same-origin Vercel deployment)
CORS_ORIGIN=http://localhost:5173

# Authentication & Security
JWT_SECRET=replace_with_a_long_random_64_char_secret_key
JWT_EXPIRES_IN=7d

# Initial Admin Account (used by `npm run db:init` when admin_users is empty)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@portfolio.local
ADMIN_PASSWORD=ChangeMeStrongPassword123!
