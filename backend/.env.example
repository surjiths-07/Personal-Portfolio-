# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL / Supabase Database Configuration
# Recommended for Vercel + Supabase (use Supabase Transaction or Session Pooler URI):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Local PostgreSQL fallback:
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=postgres
DB_SSL=false

# Set true on Vercel to auto-create tables & seed data on first cold start
AUTO_INIT_DB=true

# Frontend Origin for CORS (comma-separated; optional on same-origin Vercel deployment)
CORS_ORIGIN=http://localhost:5173

# Authentication & Security
JWT_SECRET=replace_with_a_long_random_64_char_secret_key
JWT_EXPIRES_IN=7d

# Initial Admin Account (used when admin_users table is empty)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@portfolio.local
ADMIN_PASSWORD=ChangeMeStrongPassword123!
